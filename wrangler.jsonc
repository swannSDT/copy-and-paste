{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copy-and-paste",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "CODES", "class_name": "CodeSlot" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "CodeSlot"] }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "copy-and-paste-files" }
  ]
}
